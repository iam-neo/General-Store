# ==============================================================================
# GENERAL STORE MANAGEMENT SYSTEM — ENVIRONMENT CONFIGURATION (.env.example)
#
# IMPORTANT:
# - Copy this file to `.env.local` for local development.
# - NEVER commit `.env.local` or any production secrets to version control.
# - DO NOT prefix server secrets with NEXT_PUBLIC_.
#   Variables without NEXT_PUBLIC_ are strictly server-only and unreachable by browsers.
# ==============================================================================

# ------------------------------------------------------------------------------
# Phase 5 & 5.2: Store Owner Authentication & Production Shared Storage
# ------------------------------------------------------------------------------

# Store owner username for authentication.
# Default suggestion in UI: owner
OWNER_USERNAME=owner

# Scrypt password hash for the store owner.
# Generate a hash using: npm run auth:hash -- "YourStrongPasswordHere123!"
# Example format: scrypt$N=16384,r=8,p=1$<salt-hex>$<derived-key-hex>
OWNER_PASSWORD_HASH=

# Cryptographically strong secret key used to sign HTTP-only session cookies.
# Must be at least 32 characters long.
# Example: generate with `openssl rand -hex 24` or a long random passphrase.
SESSION_SECRET=

# Shared Production Storage (Upstash Redis / Vercel KV)
# Required in production deployments (Vercel serverless) so independent instances
# reliably observe session revocations, global logout epochs, and login rate limits.
#
# Free serverless tier available at https://upstash.com or via Vercel Marketplace (KV).
# Vercel KV automatically injects KV_REST_API_URL and KV_REST_API_TOKEN.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Storage adapter selection override.
# In local development: defaults to 'file' (.auth-store directory).
# In production / Vercel: defaults to 'redis'. File adapter is strictly refused.
# Options: redis | file | memory (default: auto)
AUTH_STORAGE_TYPE=

# Custom directory for local file storage in development (optional, defaults to .auth-store).
# AUTH_STORAGE_DIR=

# Controls diagnostic test-record operations.
# In production, test writes are strictly disabled unless set to "true".
# Values: true | false (default: false in production, true in local development)
ALLOW_TEST_WRITES=false

# ------------------------------------------------------------------------------
# Phase 4: Server-to-server Google Apps Script Backend & Google Sheets Database
# ------------------------------------------------------------------------------

# The published Web App URL from Google Apps Script deployment.
# Example: https://script.google.com/macros/s/AKfycbx.../exec
# When left empty, the server automatically operates in local in-memory mock mode.
APPS_SCRIPT_URL=

# Shared secret key configured in Apps Script Script Properties as `BACKEND_SECRET`.
# Used to authenticate server-to-server POST requests and prevent unauthorized writes.
# Example: a strong 32+ character random string (e.g. openssl rand -hex 24)
APPS_SCRIPT_HMAC_SECRET=

# (Optional Reference) Google Spreadsheet ID for developer reference.
# Apps Script uses SPREADSHEET_ID in its own Script Properties to bind to the sheet.
# Example: 1BxiMVs0XRA5nFMdKvBdBZjgmUUqptlbs74OgvE2upms
GOOGLE_SPREADSHEET_ID=
